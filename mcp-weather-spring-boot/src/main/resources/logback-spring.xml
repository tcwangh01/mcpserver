<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 定義日誌檔案位置 - 使用用戶 home 目錄 -->
    <property name="LOG_FILE" value="${user.home}/mcp-weather-spring-boot.log"/>

    <!-- 檔案輸出 Appender -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_FILE}</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 只將日誌輸出到檔案，不輸出到 console -->
    <root level="WARN">
        <appender-ref ref="FILE"/>
    </root>

    <!-- 應用程式日誌 -->
    <logger name="com.example.mcpweather" level="INFO" additivity="false">
        <appender-ref ref="FILE"/>
    </logger>
</configuration>
